{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SeerBit Documentation",
  "fonts": {
    "family": "MazzardM",
    "source": "/assets/fonts/MazzardM-Regular.woff2",
    "format": "woff2",
    "heading": {
      "family": "MazzardM",
      "source": "/assets/fonts/MazzardM-Bold.woff2",
      "format": "woff2"
    }
  },
  "colors": {
    "primary": "#FF3C38",
    "light": "#FF3C38",
    "dark": "#FF3C38"
  },
  "favicon": "/favicon.ico",

  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "house",
        "groups": [
          {
            "group": "Home",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "accept-payments",
              "integration-checklist",
              "simple-checkout",
              "standard-checkout",
              "sub-account",
              "e-commerce-plugin"
            ]
          },
          {
            "group": "Payment Features",
            "pages": [
              "payments",
              "invoicing",
              "bulk-invoicing",
              "subscriptions",
              "payment-links",
              "virual-accounts",
              "card-tokenisation",
              "pocket",
              "payout"
            ]
          },
          {
            "group": "After Payment",
            "pages": [
              "verify-payments",
              "receive-settlements",
              "failed-transactions",
              "refunds",
              "webhook-events",
              "webhook-events-v2"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "book-marked",
        "openapi": {
          "source": "/openapi.yml"
        }
      }
    ]
  },
  "logo": {
    "light": "/assets/logo/Seerbit_Docs.svg",
    "dark": "/assets/logo/Seerbit_Docs_dark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign up",
      "href": "https://dashboard.seerbit.com/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
