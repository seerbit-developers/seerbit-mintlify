{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SeerBit Documentation",
  "fonts": {
    "family": "MazzardM",
    "source": "/assets/fonts/MazzardM-Regular.ttf",
    "format": "woff2",
    "heading": {
      "family": "MazzardM",
      "source": "/assets/fonts/MazzardM-Bold.ttf",
      "format": "woff2"
    },
    "paragraph": {
      "family": "MazzardM",
      "source": "/assets/fonts/MazzardM-Bold.ttf",
      "format": "woff2"
    }
  },
  "colors": {
    "primary": "#FF3C38",
    "light": "#FF3C38",
    "dark": "#FF3C38"
  },
  "favicon": "/favicon.svg",

  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Docs",
            "pages": ["index", "documentation"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": {
          "source": "/openapi.yml"
        }
      }
    ]
  },
  "logo": {
    "light": "/assets/logo/Seerbit_Docs.svg",
    "dark": "/assets/logo/Seerbit_Docs_dark.svg",
    "size": "contain"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign up",
      "href": "https://dashboard.seerbit.com/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
